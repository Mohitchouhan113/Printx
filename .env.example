[TEMPLATE]
[TEMPLATE]
# PrintX Backend Configuration
# Copy to .env and fill in values

# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/printx

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800  # 50MB

# Payment Gateway (UPI)
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here
PAYMENT_GATEWAY_URL=https://api.payment-gateway.com

# Auto-cleanup (hours)
FILE_RETENTION_HOURS=24

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# ---------------------------------------------
# Frontend (printx-frontend) — Supabase
# Copy these into printx-frontend/.env.local
# When absent, upload API + live queue run in DEMO mode (no persistence)
# ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Public base URL used to build QR-code upload links: ${NEXT_PUBLIC_APP_URL}/s/{shop_slug}
# Falls back to https://printx.qrkraft.in when unset.
NEXT_PUBLIC_APP_URL=https://printx.qrkraft.in

# ---------------------------------------------
# Frontend (printx-frontend) — Razorpay
# Copy into printx-frontend/.env.local
# When absent, checkout runs in DEMO mode (simulated gateway, no charge)
# Webhook URL to configure in the Razorpay dashboard:
#   https://your-domain.com/api/razorpay/webhook   (event: payment.captured)
# ---------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ---------------------------------------------
# Cron Job Security
# Secret token for /api/cron/cleanup (set in Vercel env vars)
# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>
# Without this, the cleanup route runs in demo mode (no auth, no deletion)
# ---------------------------------------------
CRON_SECRET=your_cron_secret_here

# ---------------------------------------------
# WhatsApp Cloud API (Meta Business)
# Copy into printx-frontend/.env.local
# When absent, messages are logged to console (demo mode)
# Get these from: https://business.facebook.com/developers/
# ---------------------------------------------
WHATSAPP_API_KEY=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
