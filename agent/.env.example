[TEMPLATE]
# PrintX Desktop Print Agent — copy to .env and fill in.
# NEVER commit the real .env (it is gitignored).

# ── Required ─────────────────────────────────────────────────────────
# Shop UUID to follow (shops.id)
SHOP_ID=YOUR_SHOP_UUID

# Supabase project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase service-role key (recommended). Anon key also works for this
# agent's reads/writes if RLS allows it — service key avoids RLS surprises.
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Optional ─────────────────────────────────────────────────────────
# Windows printer name. Omit = OS default printer.
# PRINTER=HP LaserJet Pro M404

# Tuning (defaults shown)
# POLL_INTERVAL_MS=10000   # offline catch-up poll of pending orders
# HEARTBEAT_MS=30000       # shops.last_active_at ping (Printer Status 🟢)
# LOOKBACK_HOURS=24        # catch-up window for orders missed while offline
# MAX_ATTEMPTS=3           # download/print tries before status='failed'
# ALERT=1                  # audio alert on new order (0 = silent)
# DRY_RUN=1                # log instead of spooling (no paper)
# BUCKET=print-uploads     # storage bucket for relative file_url paths
# DOWNLOAD_WORKERS=3       # parallel PDF downloads (spooling stays serial/FIFO)
# SUMATRA_PDF_EXE=C:\path\to\SumatraPDF.exe  # override the CLI driver
#   default: pdf-to-printer's bundled copy (dist/SumatraPDF*.exe), then
#   standard SumatraPDF install locations (Program Files / LOCALAPPDATA)
